# Build output
# ------------------------
dist/
build/
.out/
out/
.vite/
# Maven/Java build output (backend/target)
target/

# ------------------------
# Deploy tooling
# ------------------------
.vercel

# ------------------------
# Environment files
# ------------------------
.env
.env.*        # all environment variants (e.g. .env.local, .env.production)

