# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Backend (Spring Boot) ---
# Postgres database password (user is `postgres`, db `andromedia` by default)
POSTGRES_PASSWORD=change-me

# AWS credentials for S3 video storage
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key

# JWT signing secret — REQUIRED. Use a long, random value (>= 32 bytes).
# Generate one, e.g.:  openssl rand -base64 48
JWT_SECRET=generate-a-long-random-secret

# --- Frontend (Vite) ---
# Base URL of the backend API (leave blank to use same-origin / demo mode)
VITE_API_BASE=http://localhost:8080
# Set to "true" to run the frontend without a live backend
VITE_DEMO_MODE=false
